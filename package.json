    "cook": "./bin/cook.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./engine": "./engine.mjs",
    "./pack-file": "./pack-file.mjs",
    "./pack-input": "./pack-input.mjs",
    "./pack-input-v2": "./pack-input-v2.mjs",
    "./job-input": "./job-input.mjs",
    "./grid-volume-input": "./grid-volume-input.mjs",
    "./light-tree-v2": "./light-tree-v2.mjs",
    "./texture-mips": "./texture-mips.mjs",
    "./package.json": "./package.json",
    "./FORMAT-v2.md": "./FORMAT-v2.md",
    "./src/*": "./src/*"
  },
  "files": [
    "index.mjs",
    "post-options.mjs",
    "engine.mjs",
    "pack-file.mjs",
    "pack-input.mjs",
    "pack-input-v2.mjs",
    "job-input.mjs",
    "grid-volume-input.mjs",
    "light-tree-v2.mjs",
    "texture-mips.mjs",
    "fetch-addon.mjs",
    "bin",
    "output",
